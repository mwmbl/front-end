{
	"name": "sveltekit-frontend",
	"version": "0.0.1",
	"private": true,
	"packageManager": "bun@1.4.5",
	"engines": {
		"bun": ">=1.4.5"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"start": "bun build/index.js"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@iconify/json": "^2.2.561",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^0.515.0",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/adapter-node": "^5.5.8",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/eslint": "^9.6.1",
		"bits-ui": "^2.22.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "1.0.0-next.6",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.74.0",
		"unplugin-icons": "^0.19.3",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^5.4.21",
		"vite-plugin-top-level-await": "^1.6.0",
		"vite-plugin-wasm": "^3.6.0",
		"vitest": "^3.2.7"
	},
	"type": "module",
	"trustedDependencies": [
		"@swc/core",
		"esbuild"
	],
	"dependencies": {
		"@fontsource-variable/nunito": "^5.3.0",
		"@fontsource/hind-vadodara": "^5.3.0",
		"@polar-sh/checkout": "^0.4.3",
		"chart.js": "^4.6.2",
		"clsx": "^2.1.1",
		"formsnap": "^2.1.0",
		"tailwind-merge": "^3.7.1",
		"tailwind-variants": "^1.0.0"
	}
}
