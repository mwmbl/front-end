
<?xml version="1.0" encoding="utf-8"?>
<OpenSearchDescription
    xmlns="http://a9.com/-/spec/opensearch/1.1/"
    xmlns:moz="http://www.mozilla.org/2006/browser/search/">

    <ShortName>Mwmbl</ShortName>
    <LongName>Mwmbl Search</LongName>
    <Description>Search Mwmbl</Description>

    <InputEncoding>UTF-8</InputEncoding>

    <!-- Search results -->
    <Url
        type="text/html"
        method="get"
        template="https://mwmbl.org/search?q={searchTerms}"/>

    <!-- Search suggestions / autocomplete -->
    <Url
        type="application/x-suggestions+json"
        rel="suggestions"
        method="get"
        template="https://mwmbl.org/api/v1/search/complete?q={searchTerms}"/>

    <!-- Auto-update. Note the rel=self attribute -->
    <Url
        type="application/opensearchdescription+xml"
        rel="self"
        method="get"
        template="https://mwmbl.org/opensearch.xml"/>
    
    <moz:SearchForm>https://mwmbl.org/</moz:SearchForm>

    <Image height="16" width="16">data:image/svg+xml;base64,</Image>

    <Query role="example" searchTerms="example"/>

    <SyndicationRight>open</SyndicationRight>

</OpenSearchDescription>
